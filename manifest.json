{
  "manifest_version": 3,
  "name": "Metrolink to Google Calendar",
  "version": "1.0.0",
  "description": "Add Metrolink train departure and arrival schedules directly to Google Calendar with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Metrolink to Google Calendar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://metrolinktrains.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://metrolinktrains.com/*",
        "http://metrolinktrains.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
